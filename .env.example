# Google Gemini API Key for Wellbeing Nutrition AI Assistant (Free Tier)
# Obtain a free API key at: https://aistudio.google.com/
# Add your key in Vercel Project Settings > Environment Variables as GEMINI_API_KEY
# NEVER commit your real API key to Git or share it publicly!
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: Override default Gemini model (defaults to gemini-3.5-flash-lite, with automatic fallback to gemini-3.8-flash, gemini-3.6-flash, and gemini-3.1-flash-lite)
# GEMINI_MODEL=gemini-3.5-flash-lite
